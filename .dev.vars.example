CLOUDFLARE_API_TOKEN=your_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
CF_ACCESS_CLIENT_ID=your_access_service_token_id
CF_ACCESS_CLIENT_SECRET=your_access_service_token_secret

# Optional: additional service-token pairs for scripts/multi-agent-traffic.sh
# and scripts/combined-traffic.ts (see demo-script.md Part 8.4/8.5).
# AGENT_ALPHA_ID=your_agent_service_token_id.access
# AGENT_ALPHA_SECRET=your_agent_service_token_secret
# AGENT_BETA_ID=your_agent_service_token_id.access
# AGENT_BETA_SECRET=your_agent_service_token_secret

# Optional: minimal-scope AI Gateway run credential for gateway-mode caching.
# Create a custom API token with ONLY the "AI Gateway Run" permission scoped
# to this account (NOT the admin CLOUDFLARE_API_TOKEN — that gates the
# Worker's management endpoints and must never be embedded in a page). The
# token is injected into the Access-protected /demo page only and is shared
# by everyone who passes Access. When set, gateway-mode browser caching
# works (stable cf-aig-authorization credential); when empty (the default
# below), gateway mode shows an honest MISS hint instead. Fill in the value
# here AND run: wrangler secret put GATEWAY_RUN_TOKEN
GATEWAY_RUN_TOKEN=
