name = "ai-gateway-demo-worker"
main = "src/index.ts"
compatibility_date = "2026-10-27"
# account_id = "your_account_id"

# Worker routes on your gateway custom domain (for Identity-Aware Gateway)
# Also enable workers_dev = true to get the Worker proxy URL for service token demos
# IMPORTANT: routes must stay a top-level key, before any [table] header below —
# TOML absorbs unbracketed keys into whichever table header precedes them.
# routes = [
#   { pattern = "your-custom-domain.com/demo", zone_name = "your-domain.com" },
#   { pattern = "your-custom-domain.com/demo/*", zone_name = "your-domain.com" }
# ]
# workers_dev = true

[vars]
GATEWAY_NAME = "your-custom-domain.com"
GATEWAY_ID = "demo-gateway"
# Non-secret — used to verify the Cf-Access-Jwt-Assertion header on admin
# endpoints (see src/auth.ts). Find your team domain and this app's AUD tag
# at https://dash.cloudflare.com/?to=/:account/access/apps -> your Access app.
# Must stay uncommented (even with placeholder values) so `wrangler types`
# always includes them in Env — leaving them commented out drops the keys
# from the generated type entirely and breaks the build. Placeholder values
# are harmless if left unchanged: isValidAccessRequest() just fails closed
# (falls back to the bearer token) since the fake domain won't verify.
CF_ACCESS_TEAM_DOMAIN = "https://your-team-name.cloudflareaccess.com"
CF_ACCESS_AUD = "your_access_application_aud_tag"

# KV namespace for storing custom costs and demo settings
[[kv_namespaces]]
binding = "SETTINGS"
# id = "your_kv_namespace_id"

# Logs/traces for debugging a deployed Worker — see
# https://developers.cloudflare.com/workers/wrangler/configuration/#observability
[observability]
enabled = true
head_sampling_rate = 1

# Secrets required (set via wrangler secret put):
# - CLOUDFLARE_API_TOKEN: Token with AI Gateway Edit + Read + Workers AI Read
# - CLOUDFLARE_ACCOUNT_ID: Your Cloudflare account ID
# - CF_ACCESS_CLIENT_ID: Cloudflare Access service token client ID (for Identity-Aware Gateway)
# - CF_ACCESS_CLIENT_SECRET: Cloudflare Access service token client secret
